shader_type canvas_item;
render_mode unshaded;

// pbr_2d_surface.gdshader
// Stylized 2D PBR surface compositor for the 4-map pipeline
// (_albedo / _normal / _specular / _emission) generated by
// tools/asset_gen/generate_pbr_assets.py.
//
// Specular pack encoding (from generator):
//   R = roughness, G = metalness
// Emission map encoding:
//   RGB = glow color, A = glow intensity

group_uniforms PBRSurface;
uniform sampler2D albedo_map : source_color;
uniform sampler2D normal_map : source_color;
uniform sampler2D specular_map : source_color;
uniform sampler2D emission_map : source_color;

uniform vec4 light_color : source_color = vec4(1.0, 0.98, 0.92, 1.0);
uniform vec2 light_dir = vec2(-0.6, -0.8);
uniform float light_intensity : hint_normal = 1.0;
uniform float ambient_strength : hint_normal = 0.35;
uniform float normal_strength : hint_normal = 1.0;
uniform float emission_strength : hint_normal = 1.0;
uniform bool use_emission = true;

void fragment() {
    vec4 albedo = texture(albedo_map, UV);
    vec3 normal = normalize(texture(normal_map, UV).rgb * 2.0 - 1.0);
    vec2 spec = texture(specular_map, UV).rg;
    float roughness = spec.r;
    float metalness = spec.g;

    vec3 n = normalize(normal);
    // Flip normal Y for texture-space convention alignment.
    n.y = -n.y;
    n = normalize(n + vec3(0.0, 0.0, 1.0) * (1.0 - normal_strength));

    vec3 light_dir_n = normalize(light_dir);
    float ndl = max(dot(n, light_dir_n), 0.0);

    // Diffuse wrap for stylized look.
    float wrap_diffuse = ndl * 0.5 + 0.5;
    wrap_diffuse = pow(clamp(wrap_diffuse, 0.0, 1.0), 1.4);

    vec3 diffuse = albedo.rgb * light_color.rgb * wrap_diffuse * light_intensity;

    // Blinn-Phong specular, tone-mapped for mobile.
    vec3 view_dir = vec3(0.0, 0.0, 1.0);
    vec3 half_dir = normalize(light_dir_n + view_dir);
    float spec_pow = mix(8.0, 128.0, 1.0 - roughness);
    float spec_term = pow(max(dot(n, half_dir), 0.0), spec_pow);
    vec3 specular = light_color.rgb * spec_term * (1.0 - roughness) * (0.04 + 0.96 * metalness);

    vec3 color = albedo.rgb * ambient_strength + diffuse + specular * 0.5;

    if (use_emission) {
        vec4 emission = texture(emission_map, UV);
        color += emission.rgb * emission.a * emission_strength;
    }

    color = clamp(color, vec3(0.0), vec3(1.6));
    COLOR = vec4(color, albedo.a);
}
