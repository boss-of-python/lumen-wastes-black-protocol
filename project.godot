[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemy"
2d_physics/layer_3="Prop"
2d_physics/layer_4="PlayerFire"
2d_physics/layer_5="EnemyFire"
2d_physics/layer_6="GrappleAnchor"
2d_physics/layer_7="Vehicle"
2d_physics/layer_8="UI"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/fxaa=true
anti_aliasing/quality/use_debanding=true
lights_and_shadows/quality/max_lights_32=64
textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_canvas_texture_filter=0
textures/decals/filter=0
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)

[physics]

2d/default_gravity=1180.0
2d/solver/solver_iterations=4
common/physics_ticks_per_second=60

[internationalization]

locale/translations=PackedStringArray()

[audio]

driver/enable_input=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_touch_from_mouse_screen_multitouch=true
