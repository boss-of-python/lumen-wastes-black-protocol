; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LUMEN WASTES: BLACK PROTOCOL"
config/description="100% offline 20-hour 2D/2.5D physics action-shooter, covert-ops thriller and mythic Metroidvania for mobile. Built with Godot 4 (GDScript). Created, Directed & Developed by Tarun Loganathan."
config/author="Tarun Loganathan"
config/copyright="(c) Tarun Loganathan. All rights reserved."
config/category="Game"
run/main_scene="res://src/ui/SplashScreen.tscn"
config/features=PackedStringArray("4.3", "Mobile Vulkan", "Compatibility Renderer", "GLSL 3")
config/icon="res://icon.svg"

[autoload]

GameState="*res://src/autoload/GameState.gd"
NarrativeStateManager="*res://src/autoload/NarrativeStateManager.gd"
AudioDirector="*res://src/autoload/AudioDirector.gd"
TimeManager="*res://src/autoload/TimeManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/handheld/use_expanded_ratio=false
window/subwindows/embed_subwindows=true

