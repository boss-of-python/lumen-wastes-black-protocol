; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters
;
; NOTE: Input actions are set up at runtime by GameState.setup_input_actions()
; (see src/autoload/GameState.gd) rather than via a hand-serialized [input]
; section, to keep this ConfigFile robust and parseable.

config_version=5

[application]

config/name="LUMEN WASTES: BLACK PROTOCOL"
config/description="100% offline 20-hour 2D/2.5D physics action-shooter, covert-ops thriller and mythic Metroidvania for mobile. Built with Godot 4 (GDScript). Created, Directed & Developed by Tarun Loganathan."
config/author="Tarun Loganathan"
config/copyright="(c) Tarun Loganathan. All rights reserved."
config/category="Game"
run/main_scene="res://src/ui/SplashScreen.tscn"
config/features=PackedStringArray("4.3", "Mobile Vulkan", "Compatibility Renderer", "GLSL 3")
config/icon="res://icon.svg"

[autoload]

GameState="*res://src/autoload/GameState.gd"
NarrativeStateManager="*res://src/autoload/NarrativeStateManager.gd"
AudioDirector="*res://src/autoload/AudioDirector.gd"
TimeManager="*res://src/autoload/TimeManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/handheld/use_expanded_ratio=false
window/subwindows/embed_subwindows=true

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemy"
2d_physics/layer_3="Prop"
2d_physics/layer_4="PlayerFire"
2d_physics/layer_5="EnemyFire"
2d_physics/layer_6="GrappleAnchor"
2d_physics/layer_7="Vehicle"
2d_physics/layer_8="UI"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/fxaa=true
anti_aliasing/quality/use_debanding=true
lights_and_shadows/quality/max_lights_32=64
textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_canvas_texture_filter=0
textures/decals/filter=0
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)

[physics]

2d/default_gravity=1180.0
2d/solver/solver_iterations=4
common/physics_ticks_per_second=60

[internationalization]

locale/translations=PackedStringArray()

[audio]

driver/enable_input=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_touch_from_mouse_screen_multitouch=true
